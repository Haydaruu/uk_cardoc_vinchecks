APP_NAME=UKCarDoc
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=5432
# DB_DATABASE=ukdoc_database
# DB_USERNAME=postgres
# DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"
# The email address that receives support messages from the contact form.
SUPPORT_INBOX_ADDRESS=

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# -----------------------------------------------------------------------------
# PayPal
# Set PAYPAL_MODE to "sandbox" for testing or "live" for production.
# PAYPAL_WEBHOOK_ID must match the webhook registered in the PayPal dashboard
# for the corresponding environment (sandbox webhook ID ≠ live webhook ID).
# -----------------------------------------------------------------------------
PAYPAL_MODE=sandbox
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_WEBHOOK_ID=

# PayPal Subscription Billing Plan IDs (created in PayPal dashboard).
# Sandbox and Live environments require separate plan IDs.
PAYPAL_PLAN_PREMIUM_MONTHLY=
PAYPAL_PLAN_PREMIUM_PLUS_MONTHLY=
PAYPAL_PLAN_PREMIUM_MAX_MONTHLY=

# -----------------------------------------------------------------------------
# Stripe
# Use test keys (pk_test_... / sk_test_...) for local development.
# STRIPE_WEBHOOK_SECRET is the signing secret shown in the dashboard webhook settings.
# -----------------------------------------------------------------------------
STRIPE_KEY=
STRIPE_SECRET=
STRIPE_WEBHOOK_SECRET=

# Stripe Price IDs for one-time credit purchases
STRIPE_PRICE_1_CREDIT=
STRIPE_PRICE_3_CREDIT=
STRIPE_PRICE_5_CREDIT=
STRIPE_REPORT_PRICE_ID=
STRIPE_GUEST_REPORT_PRICE_ID=

# Stripe Price IDs for subscription plans
STRIPE_PRICE_PREMIUM_MONTHLY=
STRIPE_PRICE_PREMIUM_PLUS_MONTHLY=
STRIPE_PRICE_PREMIUM_MAX_MONTHLY=

# -----------------------------------------------------------------------------
# Telegram Notifications
# Two separate bots/chats are used:
#   - Sales bot: notified on successful payments.
#   - Activity bot: notified on guest/auth previews and vehicle-check failures.
# -----------------------------------------------------------------------------
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

TELEGRAM_ACTIVITY_BOT_TOKEN=
TELEGRAM_ACTIVITY_CHAT_ID=

# -----------------------------------------------------------------------------
# Vehicle Data Providers
# VEHICLE_REPORT_PROVIDER: "checkcardetails" (default) or "oneauto"
# VEHICLE_REPORT_STRATEGY: "single" (default) or "hybrid" (composite builder)
# -----------------------------------------------------------------------------
VEHICLE_REPORT_PROVIDER=checkcardetails
VEHICLE_REPORT_STRATEGY=single

CHECKCARDETAILS_API_KEY=
CHECKCARDETAILS_BASE_URL=

ONEAUTO_API_KEY=
ONEAUTO_BASE_URL=https://sandbox.oneautoapi.com
ONEAUTO_ENVIRONMENT=sandbox

# -----------------------------------------------------------------------------
# OAuth Social Login (Laravel Socialite)
# -----------------------------------------------------------------------------
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT=

MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=
MICROSOFT_REDIRECT=

# -----------------------------------------------------------------------------
# PDF Generation (spatie/laravel-pdf)
# LARAVEL_PDF_DRIVER: "browsershot" (default) | "chrome" | "dompdf" | "gotenberg"
# Configure only the section relevant to the chosen driver.
# -----------------------------------------------------------------------------
LARAVEL_PDF_DRIVER=browsershot

# Browsershot driver (requires Node.js + Puppeteer)
# LARAVEL_PDF_NODE_BINARY=
# LARAVEL_PDF_NPM_BINARY=
# LARAVEL_PDF_CHROME_PATH=
# LARAVEL_PDF_NO_SANDBOX=false

# Chrome-PHP driver (requires chrome-php/chrome)
# LARAVEL_PDF_CHROME_BINARY=
# LARAVEL_PDF_CHROME_NO_SANDBOX=false
# LARAVEL_PDF_CHROME_STARTUP_TIMEOUT=30
# LARAVEL_PDF_CHROME_TIMEOUT=30000
# LARAVEL_PDF_CHROME_OPERATION_TIMEOUT=5000

# Gotenberg driver (requires running Gotenberg instance)
# GOTENBERG_URL=http://localhost:3000
# GOTENBERG_USERNAME=
# GOTENBERG_PASSWORD=

# -----------------------------------------------------------------------------
# Demo / Seeding (development only — never enable in production)
# -----------------------------------------------------------------------------
ALLOW_DEMO_USER_SEEDING=false
# DEMO_ADMIN_EMAIL=
# DEMO_ADMIN_PASSWORD=
# DEMO_SUPER_ADMIN_EMAIL=
# DEMO_SUPER_ADMIN_PASSWORD=
